# Evolutionary Game Theory - Population Dynamics MVP

payoffs := [
    [V/2 - C/2, V/2 - C/2 | V, 0],
    [0, V | V/2, V/2]
] where V := 10, C := 15

hawk_dove := population_game(
    players: [
        player("Population", strategies: ["Hawk", "Dove"]),
        player("Opponent", strategies: ["Hawk", "Dove"])
    ],
    payoffs: payoffs,
    dynamics: replicator
)

print("Population game:", describe(hawk_dove))
print("ESS candidates:", find_ess(hawk_dove))
print("Pure Nash equilibria in the induced normal-form game:", solve_nash(hawk_dove))
