# Tournament of Strategies - Runnable MVP Strategy Analysis

seed(42)

strategies := {
    TitForTat: "TitForTat",
    Generous: "Generous",
    Grudger: "Grudger",
    Pavlov: "Pavlov",
    Random: "Random",
    AlwaysDefect: "AlwaysDefect",
    AlwaysCooperate: "AlwaysCooperate"
}

results := strategies
    |> tournament(rounds: 200, noise: 0.01)

ranking := results |> rank_by_performance()

print("Tournament ranking:", ranking)
print("Cooperation rates:", results.cooperation_rates)

export_csv(ranking, "strategy_tournament_ranking.csv")
export_json(results, "strategy_tournament_results.json")
