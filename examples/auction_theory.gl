# Auction Theory - First-Price Sealed-Bid Auction Metadata

bidders := [
    player("Bidder1", valuation: uniform(0, 100)),
    player("Bidder2", valuation: uniform(0, 100)),
    player("Bidder3", valuation: uniform(0, 100)),
    player("Bidder4", valuation: uniform(0, 100)),
    player("Bidder5", valuation: uniform(0, 100))
]

first_price := auction(first_price_sealed_bid, bidders: len(bidders), values: uniform(0, 100))
second_price := auction(second_price_sealed_bid, bidders: len(bidders), values: uniform(0, 100))

print("First-price auction:", first_price)
print("Second-price auction:", second_price)

export_json(first_price, "first_price_auction.json")
