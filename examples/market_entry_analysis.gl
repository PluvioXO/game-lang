# Market Entry Game - Strategic Analysis with Parameter Sweeps

players := [
    player("Incumbent", strategies: ["Accommodate", "Fight"]),
    player("Entrant", strategies: ["Enter", "Stay_Out"])
]

market_entry := game(
    players: players,
    payoffs: [
        [8,8 | 12,0],
        [2,4 | 12,0]
    ]
)

print("Market Entry Analysis")
print("====================")
print(describe(market_entry))

parameter_sweep := sweep(market_entry, values: 0..20 step 5, param: "entry_cost", metric: "price_of_anarchy")
print("Parameter sweep:", parameter_sweep)

counterexample := find_game(metric: "price_of_anarchy", greater_than: 3)
print("Counterexample game with high price of anarchy:", describe(counterexample))

export_csv(parameter_sweep, "market_entry_sweep.csv")
