# Prisoner's Dilemma - Classic Game Theory Example

# Define players with compact syntax
players := [
    player("Alice", strategies: ["C", "D"]),
    player("Bob", strategies: ["C", "D"])
]

# Payoff matrix using dense notation
# Format: [Alice's payoffs | Bob's payoffs]
pd_game := game(
    players: players,
    payoffs: [
        [3,3 | 0,5],  # Alice cooperates: (C,C)=3,3  (C,D)=0,5
        [5,0 | 1,1]   # Alice defects:   (D,C)=5,0  (D,D)=1,1
    ]
)

# Find Nash equilibria
equilibria := solve_nash(pd_game)
print("Nash equilibria:", equilibria)

# Analyze dominance
dominant := find_dominant_strategies(pd_game)
dominated := dominated_strategies(pd_game)
print("Dominant strategies:", dominant)
print("Dominated strategies:", dominated)
print("Explanation:", explain_nash(pd_game))

# Expected payoffs for mixed strategies
alice_mixed := strategy(C: 0.7, D: 0.3)
bob_mixed := strategy(C: 0.5, D: 0.5)

expected := expected_payoff(alice_mixed, bob_mixed, pd_game)
print("Expected payoffs with mixed strategies:", expected)

# Export artifacts for downstream analysis
export_json(equilibria, "prisoners_dilemma_nash.json")
export_dot(pd_game, "prisoners_dilemma.dot")
